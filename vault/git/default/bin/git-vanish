#!/usr/bin/env bash
set -euo pipefail

# NAME
#   git-vanish - Delete local branches whose upstream is gone
#
# SYNOPSIS
#   git vanish [-n|--dry-run] [-f|--force]
#
# DESCRIPTION
#   Deletes local branches that are tracking remote branches which no longer exist.
#   Uses `git branch -d` by default, which only deletes fully merged branches.
#   If a branch is checked out in a linked worktree, the worktree is removed
#   first. Worktrees with modified or untracked files are left as they are,
#   and their branches are skipped.
#
# OPTIONS
#   -n, --dry-run
#       Print branches that would be deleted without actually deleting them.
#
#   -f, --force
#       Force delete branches using `git branch -D`, even if not fully merged.
#
# EXAMPLES
#   $ git vanish
#   Deleted branch feature/old (was a1b2c3d).
#
#   $ git vanish --force
#   Deleted branch feature/unmerged (was b2c3d4e).

usage() {
    awk '
        /^[^#]/ { if (f) exit }
        /^# NAME/ { f = 1 }
        f { sub(/^# ?/, ""); print }
    ' "$0"
}

dry_run=false
force=false

while [[ "$#" -gt 0 ]]; do
    case $1 in
        -h|--help)
            usage
            exit 0 ;;

        -n|--dry-run)
            dry_run=true
            shift ;;

        -f|--force)
            force=true
            shift ;;

        *) echo "Unknown parameter passed: $1"
           exit 1 ;;
    esac
done

branches=$(git for-each-ref --format='%(refname:short) %(upstream:track)' refs/heads/ | awk '$2 == "[gone]" {print $1}')

if [[ -z "$branches" ]]; then
    exit 0
fi

if $dry_run; then
    for branch in $branches; do
        echo "Would delete branch $branch"
    done
    exit 0
fi

flags=(-d)

if $force; then
    flags+=(-f)
fi

# Print the path of the linked worktree that has the branch checked out.
# The main worktree is excluded because it cannot be removed.
worktree_of() {
    git worktree list --porcelain | awk -v ref="refs/heads/$1" '
        /^worktree / { n++; path = substr($0, 10) }
        /^branch / && n > 1 && $2 == ref { print path; exit }
    '
}

targets=()

for branch in $branches; do
    worktree=$(worktree_of "$branch")

    if [[ -n "$worktree" ]]; then
        # Refuses worktrees with modified or untracked files, so no work is lost.
        if ! git worktree remove "$worktree"; then
            echo "Skipped branch $branch (worktree $worktree is not clean)" >&2
            continue
        fi
        echo "Removed worktree $worktree"
    fi

    targets+=("$branch")
done

if [[ "${#targets[@]}" -gt 0 ]]; then
    git branch "${flags[@]}" "${targets[@]}"
fi
